{
  "openapi": "3.1.0",
  "info": {
    "title": "IL Vacation Budget Estimator API",
    "version": "1"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/origins": {
      "get": {
        "summary": "Origins",
        "operationId": "origins",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Origin"
                  },
                  "type": "array",
                  "title": "Response Origins"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/data-quality": {
      "get": {
        "summary": "Data Quality",
        "operationId": "data_quality",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataQuality"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/estimates": {
      "post": {
        "summary": "Create Estimate",
        "operationId": "create_estimate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstimateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstimateResponse"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/searches": {
      "get": {
        "summary": "List Searches",
        "operationId": "list_searches",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SearchSummary"
                  },
                  "type": "array",
                  "title": "Response List Searches"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/searches/{search_id}": {
      "get": {
        "summary": "Get Saved Search",
        "operationId": "get_saved_search",
        "parameters": [
          {
            "name": "search_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Search Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedSearch"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/destinations": {
      "get": {
        "summary": "Destinations",
        "operationId": "destinations",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Destination"
                  },
                  "type": "array",
                  "title": "Response Destinations"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/destinations/{destination_id}/trip": {
      "get": {
        "summary": "Destination Trip",
        "operationId": "destination_trip",
        "parameters": [
          {
            "name": "destination_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Destination Id"
            }
          },
          {
            "name": "depart_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Depart Date"
            }
          },
          {
            "name": "return_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Return Date"
            }
          },
          {
            "name": "origin_iata",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "TLV",
              "title": "Origin Iata"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "ILS",
                "USD",
                "EUR"
              ],
              "type": "string",
              "default": "ILS",
              "title": "Currency"
            }
          },
          {
            "name": "travelers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9,
              "minimum": 1,
              "description": "Everyone flying; each needs a seat",
              "default": 1,
              "title": "Travelers"
            },
            "description": "Everyone flying; each needs a seat"
          },
          {
            "name": "rooms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9,
              "minimum": 1,
              "description": "Hotel rooms; a room's price is for two adults (SerpApi's default occupancy)",
              "default": 1,
              "title": "Rooms"
            },
            "description": "Hotel rooms; a room's price is for two adults (SerpApi's default occupancy)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/destinations/{destination_id}/date-grid": {
      "get": {
        "summary": "Destination Date Grid",
        "operationId": "destination_date_grid",
        "parameters": [
          {
            "name": "destination_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Destination Id"
            }
          },
          {
            "name": "depart_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Depart Date"
            }
          },
          {
            "name": "return_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Return Date"
            }
          },
          {
            "name": "origin_iata",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "TLV",
              "title": "Origin Iata"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "ILS",
                "USD",
                "EUR"
              ],
              "type": "string",
              "default": "ILS",
              "title": "Currency"
            }
          },
          {
            "name": "travelers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9,
              "minimum": 1,
              "description": "Everyone flying; each needs a seat",
              "default": 1,
              "title": "Travelers"
            },
            "description": "Everyone flying; each needs a seat"
          },
          {
            "name": "rooms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9,
              "minimum": 1,
              "description": "Hotel rooms; a room's price is for two adults (SerpApi's default occupancy)",
              "default": 1,
              "title": "Rooms"
            },
            "description": "Hotel rooms; a room's price is for two adults (SerpApi's default occupancy)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DateGrid"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DailyVolume": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "observations_collected": {
            "type": "integer",
            "title": "Observations Collected",
            "description": "Rows the collector added"
          },
          "observations_from_searches": {
            "type": "integer",
            "title": "Observations From Searches",
            "description": "Rows stored from users' live destination views"
          }
        },
        "type": "object",
        "required": [
          "day",
          "observations_collected",
          "observations_from_searches"
        ],
        "title": "DailyVolume"
      },
      "DataQuality": {
        "properties": {
          "coverage": {
            "items": {
              "$ref": "#/components/schemas/DestinationCoverage"
            },
            "type": "array",
            "title": "Coverage"
          },
          "collection_volume": {
            "items": {
              "$ref": "#/components/schemas/DailyVolume"
            },
            "type": "array",
            "title": "Collection Volume"
          }
        },
        "type": "object",
        "required": [
          "coverage",
          "collection_volume"
        ],
        "title": "DataQuality"
      },
      "DateGrid": {
        "properties": {
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Every amount is in this currency: the one requested, or USD if it has no rate"
          },
          "days": {
            "type": "integer",
            "title": "Days",
            "description": "The grid spans this many days either side of the requested dates"
          },
          "cells": {
            "items": {
              "$ref": "#/components/schemas/DateGridCell"
            },
            "type": "array",
            "title": "Cells",
            "description": "Only the date pairs with a flight on file - an absent pair is missing data"
          }
        },
        "type": "object",
        "required": [
          "currency",
          "days",
          "cells"
        ],
        "title": "DateGrid"
      },
      "DateGridCell": {
        "properties": {
          "depart_date": {
            "type": "string",
            "format": "date",
            "title": "Depart Date"
          },
          "return_date": {
            "type": "string",
            "format": "date",
            "title": "Return Date"
          },
          "nights": {
            "type": "integer",
            "title": "Nights"
          },
          "flight_amount": {
            "type": "number",
            "title": "Flight Amount",
            "description": "One traveler's cheapest round trip on file for these exact dates"
          },
          "total_amount": {
            "$ref": "#/components/schemas/TierTotals",
            "description": "Every traveler's flight + every room for these nights, per hotel tier; null when the tier has no hotel price"
          }
        },
        "type": "object",
        "required": [
          "depart_date",
          "return_date",
          "nights",
          "flight_amount",
          "total_amount"
        ],
        "title": "DateGridCell"
      },
      "Destination": {
        "properties": {
          "destination_id": {
            "type": "integer",
            "title": "Destination Id"
          },
          "city_name": {
            "type": "string",
            "title": "City Name"
          },
          "country_name": {
            "type": "string",
            "title": "Country Name"
          },
          "city_name_he": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City Name He",
            "description": "Hebrew name; null when the seed has none (show city_name)"
          },
          "country_name_he": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Name He",
            "description": "Hebrew name; null when the seed has none (show country_name)"
          },
          "iata_code": {
            "type": "string",
            "title": "Iata Code"
          }
        },
        "type": "object",
        "required": [
          "destination_id",
          "city_name",
          "country_name",
          "city_name_he",
          "country_name_he",
          "iata_code"
        ],
        "title": "Destination"
      },
      "DestinationCoverage": {
        "properties": {
          "city_name": {
            "type": "string",
            "title": "City Name"
          },
          "country_name": {
            "type": "string",
            "title": "Country Name"
          },
          "city_name_he": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City Name He",
            "description": "Hebrew name; null when the seed has none (show city_name)"
          },
          "country_name_he": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Name He",
            "description": "Hebrew name; null when the seed has none (show country_name)"
          },
          "flight_obs_count": {
            "type": "integer",
            "title": "Flight Obs Count"
          },
          "hotel_sample_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hotel Sample Size",
            "description": "null when the city has no hotel price on file"
          },
          "hotel_price_age_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hotel Price Age Days",
            "description": "null when the city has no hotel price on file"
          }
        },
        "type": "object",
        "required": [
          "city_name",
          "country_name",
          "city_name_he",
          "country_name_he",
          "flight_obs_count",
          "hotel_sample_size",
          "hotel_price_age_days"
        ],
        "title": "DestinationCoverage"
      },
      "DestinationEstimate": {
        "properties": {
          "destination_id": {
            "type": "integer",
            "title": "Destination Id"
          },
          "city_name": {
            "type": "string",
            "title": "City Name"
          },
          "city_name_he": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City Name He",
            "description": "Hebrew name; null when the seed has none (show city_name)"
          },
          "airline_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Airline Code"
          },
          "airline_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Airline Name",
            "description": "null when the airline code isn't in our reference table"
          },
          "flight_out_date": {
            "type": "string",
            "format": "date",
            "title": "Flight Out Date"
          },
          "flight_return_date": {
            "type": "string",
            "format": "date",
            "title": "Flight Return Date"
          },
          "matched_nights": {
            "type": "integer",
            "title": "Matched Nights",
            "description": "Nights of the matched flight, which the hotel is priced for - may differ from the request"
          },
          "flight_price_amount": {
            "type": "number",
            "title": "Flight Price Amount",
            "description": "One traveler's round trip"
          },
          "flight_total_amount": {
            "type": "number",
            "title": "Flight Total Amount",
            "description": "Every traveler's round trip"
          },
          "hotel_total_amount": {
            "type": "number",
            "title": "Hotel Total Amount",
            "description": "Every room, for matched_nights"
          },
          "total_estimate_amount": {
            "type": "number",
            "title": "Total Estimate Amount",
            "description": "Flights + hotel, for the whole party"
          },
          "flight_seen_on": {
            "type": "string",
            "format": "date",
            "title": "Flight Seen On",
            "description": "The day a real Aviasales search last saw this flight price"
          },
          "hotel_price_age_days": {
            "type": "integer",
            "title": "Hotel Price Age Days",
            "description": "Days since the city's hotel prices were collected"
          }
        },
        "type": "object",
        "required": [
          "destination_id",
          "city_name",
          "city_name_he",
          "airline_code",
          "airline_name",
          "flight_out_date",
          "flight_return_date",
          "matched_nights",
          "flight_price_amount",
          "flight_total_amount",
          "hotel_total_amount",
          "total_estimate_amount",
          "flight_seen_on",
          "hotel_price_age_days"
        ],
        "title": "DestinationEstimate"
      },
      "ErrorDetail": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorDetail"
      },
      "EstimateRequest": {
        "properties": {
          "origin_iata": {
            "type": "string",
            "title": "Origin Iata"
          },
          "depart_date": {
            "type": "string",
            "format": "date",
            "title": "Depart Date"
          },
          "return_date": {
            "type": "string",
            "format": "date",
            "title": "Return Date"
          },
          "budget_amount": {
            "type": "number",
            "exclusiveMaximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Budget Amount"
          },
          "budget_currency": {
            "type": "string",
            "enum": [
              "ILS",
              "USD",
              "EUR"
            ],
            "title": "Budget Currency",
            "default": "ILS"
          },
          "hotel_tier": {
            "type": "string",
            "enum": [
              "budget",
              "average",
              "luxury"
            ],
            "title": "Hotel Tier",
            "description": "The tier saved to history; the response always has all three",
            "default": "average"
          },
          "travelers": {
            "type": "integer",
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Travelers",
            "description": "Everyone flying; each needs a seat",
            "default": 1
          },
          "rooms": {
            "type": "integer",
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Rooms",
            "description": "Hotel rooms; a room's price is for two adults (SerpApi's default occupancy)",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "origin_iata",
          "depart_date",
          "return_date",
          "budget_amount"
        ],
        "title": "EstimateRequest"
      },
      "EstimateResponse": {
        "properties": {
          "search_id": {
            "type": "integer",
            "title": "Search Id"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Every amount is in this currency: the budget's, or USD if it has no rate"
          },
          "budget_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Amount",
            "description": "null when the budget currency has no exchange rate - results are then not filtered by budget"
          },
          "tiers": {
            "$ref": "#/components/schemas/TierEstimates"
          }
        },
        "type": "object",
        "required": [
          "search_id",
          "currency",
          "budget_amount",
          "tiers"
        ],
        "title": "EstimateResponse"
      },
      "FlightOption": {
        "properties": {
          "depart_date": {
