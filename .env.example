# postgresql://<user>:<password>@<host>:<port>/<dbname> -- matches whatever
# user/password/dbname you passed to `docker run` (or docker-compose.yml), e.g.
#   postgresql://vacation:<password>@localhost:5433/vacation_budget
DB_URL=

# Register for free at https://www.travelpayouts.com/programs/100/tools/api
# Used by etl/collectors/flights_collector.py (v3/prices_for_dates).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Register for free at https://serpapi.com (250 searches/month free, no card
# required). Used by etl/collectors/hotels_collector.py -- see that module's
# docstring for why this is run manually/rarely, not automated.
SERPAPI_KEY=

# Signs the anonymous session cookie used to scope /history to one browser
# (see app/main.py). Any random string; generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
